generator client {
  provider   = "prisma-client-js"
  output     = "./generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum LocaleSource {
  TELEGRAM
  MANUAL
}

enum UserSystemRole {
  USER
  ADMIN
}

enum OrganizationStatus {
  ACTIVE
  ARCHIVED
  DELETING
}

enum OrganizationDeletionJobStatus {
  PENDING
  DONE
  FAILED
}

enum OrganizationModule {
  REVIEW
  COMPLAINT
  SUGGESTION
  STAFF
}

enum SubmissionKind {
  REVIEW
  COMPLAINT
  SUGGESTION
}

enum MediaOwnerType {
  USER
  ORGANIZATION
  STAFF_MEMBER
  SUBMISSION
}

enum MediaAssetKind {
  ORGANIZATION_LOGO
  STAFF_AVATAR
  SUBMISSION_PHOTO
  SUBMISSION_THUMBNAIL
}

enum MediaAssetStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  DELETED
}

enum MediaUploadSessionStatus {
  PENDING
  UPLOADED
  PROCESSING
  READY
  FAILED
  CANCELED
  EXPIRED
}

enum OrganizationNotificationMode {
  ALL
  IMPORTANT_ONLY
  OFF
}

enum OrganizationNotificationTargetStatus {
  ACTIVE
  DISCONNECTED
}

enum TelegramDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum QrPdfDeliveryStatus {
  PROCESSING
  SENT
  FAILED
}

enum TelegramNotificationTargetType {
  OWNER_DM
  TELEGRAM_GROUP
}

enum SubscriptionPlanCode {
  MONTHLY
  ANNUAL
}

enum OrganizationSubscriptionStatus {
  TRIALING
  ACTIVE
  EXPIRED
  CANCELED
  GRANTED
}

enum OrganizationSubscriptionSource {
  TRIAL
  TELEGRAM_STARS
  ADMIN_GRANT
}

enum OrganizationSubscriptionPaymentStatus {
  PAID
  FAILED
  REFUNDED
  CANCELED
}

enum OrganizationSubscriptionEventType {
  TRIAL_STARTED
  PAYMENT_PAID
  PAYMENT_FAILED
  REFUNDED
  ADMIN_GRANTED
  EXPIRED
  CANCELED
  RENEWED
}

enum BroadcastTargetKind {
  ALL_USERS
  ORGANIZATION_OWNERS
  SYSTEM_ADMINS
}

enum BroadcastStatus {
  DRAFT
  SENDING
  SENT
  FAILED
  CANCELED
}

enum BroadcastRecipientStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model User {
  id            String         @id @default(cuid())
  telegram_id   BigInt         @unique
  first_name    String
  last_name     String?
  username      String?
  phone_number  String?
  language_code String?
  photo_url     String?
  locale        String         @default("ru")
  locale_source LocaleSource   @default(TELEGRAM)
  system_role   UserSystemRole @default(USER)

  owned_organizations               Organization[]                              @relation("OwnedOrganizations")
  customer_submissions              Submission[]                                @relation("CustomerSubmissions")
  media_upload_sessions             MediaUploadSession[]
  notification_targets              OrganizationNotificationTarget[]            @relation("RecipientUserNotificationTargets")
  notification_group_connect_tokens OrganizationNotificationGroupConnectToken[] @relation("NotificationGroupConnectTokensCreated")
  notification_deliveries           TelegramNotificationDelivery[]              @relation("RecipientUserDeliveries")
  subscription_grants               OrganizationSubscription[]                  @relation("GrantedOrganizationSubscriptions")
  subscription_payments             OrganizationSubscriptionPayment[]           @relation("SubscriptionPaymentsByUser")
  subscription_events               OrganizationSubscriptionEvent[]             @relation("SubscriptionEventsByUser")
  created_broadcasts                Broadcast[]                                 @relation("CreatedBroadcasts")
  broadcast_recipients              BroadcastRecipient[]
  organization_deletion_jobs        OrganizationDeletionJob[]                   @relation("OrganizationDeletionJobsRequested")
  guest_entry_scans                 GuestEntryScan[]
  system_audit_logs                 SystemAuditLog[]                            @relation("SystemAuditLogActor")
  qr_pdf_deliveries                 QrPdfDelivery[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([username])
  @@index([locale])
  @@index([locale_source])
  @@index([system_role])
}

model Organization {
  id                  String             @id @default(cuid())
  owner_user_id       String
  status              OrganizationStatus @default(ACTIVE)
  name                String
  slug                       String             @unique
  creation_client_request_id String?            @unique
  description                String             @default("")
  contact_text               String             @default("")
  logo_media_asset_id        String?
  locale                     String             @default("ru")
  time_zone                  String             @default("UTC")

  owner                             User                                        @relation("OwnedOrganizations", fields: [owner_user_id], references: [id], onDelete: Cascade)
  module_settings                   OrganizationModuleSetting[]
  notification_targets              OrganizationNotificationTarget[]
  notification_group_connect_tokens OrganizationNotificationGroupConnectToken[]
  subscription                      OrganizationSubscription?
  subscription_payments             OrganizationSubscriptionPayment[]
  subscription_events               OrganizationSubscriptionEvent[]
  guest_contexts                    OrganizationGuestContext[]
  guest_entry_scans                 GuestEntryScan[]
  staff_members                     StaffMember[]
  submissions                       Submission[]
  deletion_jobs                     OrganizationDeletionJob[]
  qr_pdf_deliveries                 QrPdfDelivery[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([owner_user_id, status])
  @@index([status, created_at])
  @@index([time_zone])
}

model OrganizationDeletionJob {
  id                   String                        @id @default(cuid())
  organization_id      String?
  requested_by_user_id String?
  organization_name    String
  organization_slug    String
  storage_objects      Json?
  status               OrganizationDeletionJobStatus @default(PENDING)
  attempt_count        Int                           @default(0)
  next_attempt_at      DateTime                      @default(now())
  locked_until         DateTime?
  error                String?
  started_at           DateTime?
  completed_at         DateTime?
  failed_at            DateTime?

  organization      Organization? @relation(fields: [organization_id], references: [id], onDelete: SetNull)
  requested_by_user User?         @relation("OrganizationDeletionJobsRequested", fields: [requested_by_user_id], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([organization_id, created_at])
  @@index([requested_by_user_id, created_at])
  @@index([status, next_attempt_at, locked_until])
}

model OrganizationNotificationTarget {
  id                  String                               @id @default(cuid())
  organization_id     String
  type                TelegramNotificationTargetType
  status              OrganizationNotificationTargetStatus @default(ACTIVE)
  mode                OrganizationNotificationMode         @default(ALL)
  review_enabled      Boolean                              @default(true)
  complaint_enabled   Boolean                              @default(true)
  suggestion_enabled  Boolean                              @default(true)
  telegram_chat_id    BigInt?
  telegram_chat_title String?
  recipient_user_id   String?
  connected_at        DateTime?
  disconnected_at     DateTime?
  last_error          String?

  organization   Organization                   @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  recipient_user User?                          @relation("RecipientUserNotificationTargets", fields: [recipient_user_id], references: [id], onDelete: Cascade)
  deliveries     TelegramNotificationDelivery[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([organization_id, status])
  @@index([organization_id, type])
  @@index([type, status])
  @@index([telegram_chat_id])
}

model OrganizationNotificationGroupConnectToken {
  id                 String    @id @default(cuid())
  organization_id    String
  token              String    @unique
  created_by_user_id String
  expires_at         DateTime
  used_at            DateTime?

  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  created_by_user User         @relation("NotificationGroupConnectTokensCreated", fields: [created_by_user_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([organization_id, created_at])
  @@index([created_by_user_id, created_at])
  @@index([token, expires_at])
}

model OrganizationSubscription {
  id                         String                         @id @default(cuid())
  organization_id            String                         @unique
  status                     OrganizationSubscriptionStatus @default(TRIALING)
  plan_code                  SubscriptionPlanCode?
  source                     OrganizationSubscriptionSource @default(TRIAL)
  trial_started_at           DateTime?
  trial_ends_at              DateTime?
  current_period_started_at  DateTime?
  current_period_ends_at     DateTime?
  cancel_at_period_end       Boolean                        @default(false)
  telegram_payment_charge_id String?
  granted_by_user_id         String?
  grant_reason               String?

  organization    Organization                      @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  granted_by_user User?                             @relation("GrantedOrganizationSubscriptions", fields: [granted_by_user_id], references: [id], onDelete: SetNull)
  payments        OrganizationSubscriptionPayment[]
  events          OrganizationSubscriptionEvent[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([status, current_period_ends_at])
  @@index([source, status])
  @@index([granted_by_user_id, created_at])
}

model OrganizationSubscriptionPayment {
  id                           String                                @id @default(cuid())
  organization_id              String
  subscription_id              String
  payer_user_id                String?
  plan_code                    SubscriptionPlanCode
  amount_stars                 Int
  currency                     String                                @default("XTR")
  status                       OrganizationSubscriptionPaymentStatus
  telegram_invoice_payload     String
  telegram_payment_charge_id   String?                               @unique
  provider_payment_charge_id   String?
  is_recurring                 Boolean                               @default(false)
  is_first_recurring           Boolean                               @default(false)
  subscription_expiration_date DateTime?
  raw_payload                  Json?
  paid_at                      DateTime?
  refunded_at                  DateTime?

  organization Organization                    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  subscription OrganizationSubscription        @relation(fields: [subscription_id], references: [id], onDelete: Cascade)
  payer_user   User?                           @relation("SubscriptionPaymentsByUser", fields: [payer_user_id], references: [id], onDelete: SetNull)
  events       OrganizationSubscriptionEvent[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([organization_id, status, created_at])
  @@index([subscription_id, status, created_at])
  @@index([payer_user_id, status, created_at])
  @@index([telegram_invoice_payload, status, created_at])
}

model OrganizationSubscriptionEvent {
  id              String                            @id @default(cuid())
  organization_id String
  subscription_id String?
  payment_id      String?
  actor_user_id   String?
  type            OrganizationSubscriptionEventType
  metadata        Json?

  organization Organization                     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  subscription OrganizationSubscription?        @relation(fields: [subscription_id], references: [id], onDelete: SetNull)
  payment      OrganizationSubscriptionPayment? @relation(fields: [payment_id], references: [id], onDelete: SetNull)
  actor_user   User?                            @relation("SubscriptionEventsByUser", fields: [actor_user_id], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())

  @@index([organization_id, created_at])
  @@index([subscription_id, created_at])
  @@index([payment_id, created_at])
  @@index([actor_user_id, created_at])
  @@index([type, created_at])
}

model OrganizationModuleSetting {
  id              String             @id @default(cuid())
  organization_id String
  module          OrganizationModule
  enabled         Boolean            @default(true)
  config          Json?

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([organization_id, module])
  @@index([module, enabled])
}

model OrganizationGuestContext {
  id              String @id @default(cuid())
  organization_id String
  code            String
  label           String

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([organization_id, code])
  @@unique([organization_id, label])
  @@index([organization_id, created_at])
}

model GuestEntryScan {
  id              String  @id @default(cuid())
  organization_id String
  user_id         String?
  start_param     String
  qr_context      String?
  locale          String?
  platform        String?

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [user_id], references: [id], onDelete: SetNull)
  submissions  Submission[]

  created_at DateTime @default(now())

  @@index([organization_id, created_at])
  @@index([user_id, created_at])
  @@index([start_param, created_at])
  @@index([created_at])
}

model SystemAuditLog {
  id            String  @id @default(cuid())
  actor_user_id String?
  action        String
  target_type   String
  target_id     String?
  metadata      Json?

  actor_user User? @relation("SystemAuditLogActor", fields: [actor_user_id], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())

  @@index([actor_user_id, created_at])
  @@index([target_type, target_id, created_at])
  @@index([action, created_at])
  @@index([created_at])
}

model QrPdfDelivery {
  id                  String              @id @default(cuid())
  organization_id     String
  user_id             String
  client_request_id   String              @unique
  status              QrPdfDeliveryStatus @default(PROCESSING)
  file_name           String
  telegram_message_id Int?
  error               String?
  sent_at             DateTime?
  failed_at           DateTime?

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([organization_id, user_id, created_at])
  @@index([status, created_at])
}

model StaffMember {
  id                         String  @id @default(cuid())
  organization_id            String
  creation_client_request_id String? @unique
  display_name               String
  role_title                 String  @default("")
  avatar_media_asset_id      String?
  is_active                  Boolean @default(true)
  sort_order                 Int     @default(0)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  submissions  Submission[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([organization_id, is_active, sort_order])
}

model Submission {
  id                     String         @id @default(cuid())
  organization_id        String
  customer_user_id       String?
  guest_entry_scan_id    String?
  client_request_id      String?        @unique
  target_staff_member_id String?
  kind                   SubmissionKind
  rating                 Int?
  body_text              String         @default("")
  customer_allows_reply  Boolean        @default(false)
  customer_contact_phone String?
  customer_display_name  String?
  qr_context             String?
  locale                 String         @default("ru")
  metadata               Json?

  organization            Organization                   @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  customer_user           User?                          @relation("CustomerSubmissions", fields: [customer_user_id], references: [id], onDelete: SetNull)
  guest_entry_scan        GuestEntryScan?                @relation(fields: [guest_entry_scan_id], references: [id], onDelete: SetNull)
  target_staff_member     StaffMember?                   @relation(fields: [target_staff_member_id], references: [id], onDelete: SetNull)
  attachments             SubmissionAttachment[]
  notification_deliveries TelegramNotificationDelivery[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([organization_id, created_at])
  @@index([organization_id, kind, created_at])
  @@index([kind, created_at])
  @@index([guest_entry_scan_id])
  @@index([target_staff_member_id, created_at])
  @@index([customer_user_id, created_at])
}

model SubmissionAttachment {
  id             String @id @default(cuid())
  submission_id  String
  media_asset_id String
  sort_order     Int    @default(0)

  submission  Submission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  media_asset MediaAsset @relation(fields: [media_asset_id], references: [id], onDelete: Restrict)

  created_at DateTime @default(now())

  @@unique([submission_id, media_asset_id])
  @@index([submission_id, sort_order])
  @@index([media_asset_id])
}

model MediaUploadSession {
  id                String                   @id @default(cuid())
  user_id           String?
  owner_type        MediaOwnerType
  owner_id          String
  kind              MediaAssetKind
  status            MediaUploadSessionStatus @default(PENDING)
  bucket            String
  temp_storage_key  String                   @unique
  final_storage_key String?
  file_name         String
  content_type      String
  size_limit_bytes  Int
  expires_at        DateTime
  uploaded_at       DateTime?
  processed_at      DateTime?
  failed_at         DateTime?
  last_error        String?
  metadata          Json?

  user         User?        @relation(fields: [user_id], references: [id], onDelete: SetNull)
  media_assets MediaAsset[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id, status, created_at])
  @@index([owner_type, owner_id, status, created_at])
  @@index([status, expires_at])
  @@index([kind, status, created_at])
}

model MediaAsset {
  id                String           @id @default(cuid())
  upload_session_id String?
  owner_type        MediaOwnerType
  owner_id          String
  kind              MediaAssetKind
  status            MediaAssetStatus @default(PROCESSING)
  bucket            String
  storage_key       String           @unique
  public_url        String
  content_type      String
  size_bytes        Int?
  width             Int?
  height            Int?
  checksum          String?
  metadata          Json?

  upload_session         MediaUploadSession?    @relation(fields: [upload_session_id], references: [id], onDelete: SetNull)
  submission_attachments SubmissionAttachment[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([upload_session_id])
  @@index([owner_type, owner_id, kind, created_at])
  @@index([kind, status, created_at])
}

model TelegramNotificationDelivery {
  id                   String                         @id @default(cuid())
  submission_id        String
  target_id            String
  target_type          TelegramNotificationTargetType @default(OWNER_DM)
  recipient_user_id    String?
  status               TelegramDeliveryStatus         @default(PENDING)
  telegram_chat_id     BigInt?
  telegram_message_ids Json?
  error                String?
  attempt_count        Int                            @default(0)
  next_attempt_at      DateTime                       @default(now())
  locked_until         DateTime?
  failed_at            DateTime?
  sent_at              DateTime?

  submission     Submission                     @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  target         OrganizationNotificationTarget @relation(fields: [target_id], references: [id], onDelete: Cascade)
  recipient_user User?                          @relation("RecipientUserDeliveries", fields: [recipient_user_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([submission_id, status])
  @@index([target_id, status, created_at])
  @@index([recipient_user_id, status, created_at])
  @@index([target_type, status, created_at])
  @@index([status, next_attempt_at, locked_until])
}

model Broadcast {
  id                 String              @id @default(cuid())
  created_by_user_id String?
  target_kind        BroadcastTargetKind @default(ALL_USERS)
  status             BroadcastStatus     @default(DRAFT)
  locale             String?
  text               String
  metadata           Json?
  started_at         DateTime?
  sent_at            DateTime?
  failed_at          DateTime?
  error              String?

  created_by_user User?                @relation("CreatedBroadcasts", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  recipients      BroadcastRecipient[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([created_by_user_id, created_at])
  @@index([target_kind, status])
  @@index([status, created_at])
}

model BroadcastRecipient {
  id                  String                   @id @default(cuid())
  broadcast_id        String
  user_id             String
  status              BroadcastRecipientStatus @default(PENDING)
  telegram_chat_id    BigInt?
  telegram_message_id Int?
  error               String?
  sent_at             DateTime?

  broadcast Broadcast @relation(fields: [broadcast_id], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([broadcast_id, user_id])
  @@index([user_id, status, created_at])
  @@index([status, created_at])
}
