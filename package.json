{
  "name": "izoh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.4.2",
  "author": {
    "name": "Komron Rakhimov",
    "email": "komronrakhimov@icloud.com"
  },
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "vite --host 0.0.0.0",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:notification-dispatcher": "tsx watch src/server/notification-dispatcher/index.ts",
    "dev:organization-deletion-worker": "tsx watch src/server/organization-deletion-worker/index.ts",
    "start": "npm run start:api",
    "setup": "node scripts/setup.mjs",
    "setup:verify": "node scripts/setup.mjs --verify",
    "build": "npm run build:web",
    "build:web": "npm run db:generate && tsc -p tsconfig.json --noEmit && vite build",
    "start:web": "node scripts/serve-web.mjs",
    "build:api": "npm run db:generate && tsc -p tsconfig.json --noEmit",
    "start:api": "tsx src/server/index.ts",
    "build:notification-dispatcher": "npm run db:generate && tsc -p tsconfig.json --noEmit",
    "start:notification-dispatcher": "tsx src/server/notification-dispatcher/index.ts",
    "build:organization-deletion-worker": "npm run db:generate && tsc -p tsconfig.json --noEmit",
    "start:organization-deletion-worker": "tsx src/server/organization-deletion-worker/index.ts",
    "predeploy:railway": "node scripts/railway-predeploy.mjs",
    "start:railway": "node scripts/railway-start.mjs",
    "preview": "npm run start:web",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "predeploy:api": "node scripts/deploy.mjs",
    "verify": "npm run typecheck && npm run test",
    "admin:grant": "tsx src/server/cli/grant-system-admin.ts",
    "admin:grant-subscription": "tsx src/server/cli/grant-organization-subscription.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1062.0",
    "@aws-sdk/s3-request-presigner": "^3.1062.0",
    "@hono/node-server": "^2.0.4",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.11",
    "@telegram-apps/sdk": "^3.11.8",
    "@telegram-apps/sdk-react": "^3.3.9",
    "@vitejs/plugin-react": "^6.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.40.0",
    "grammy": "^1.43.0",
    "hono": "^4.12.23",
    "i18next": "^26.3.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.8.3"
  },
  "overrides": {
    "valibot": "^1.4.1"
  }
}
